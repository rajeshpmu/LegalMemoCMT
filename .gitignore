# Keep source and manifest files only.
# Safety note:
# - `data/` is ignored except for `data/manifests/`.
# - Use the exact-add helper in `scripts/git_add_public_exact.sh`.
# - Do not run `git add data/` or `git add .` when preparing a public push.

# Data: ignore everything except manifests.
data/*
!data/manifests/
!data/manifests/**
!data/processed/phase2/clancy/*.csv

# Generated docs and reports.
implementation_docments/
results/
artifacts/
backups/
submission_first/
scripts/backups_*/

# Generated figures and diagram exports.
*.png
*.mmd
*.svg

# Word documents.
*.docx

# Local clutter.
.DS_Store
*.zip
*.tar.gz
*.tgz

# Python cache / bytecode.
__pycache__/
*.pyc
*.pyo
*.pyd
